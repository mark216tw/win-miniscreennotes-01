<Window x:Class="Com.MiniScreenNotes.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Margin="8"
            Padding="14,10"
            CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            Cursor="Hand"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseEnter="Border_MouseEnter"
            MouseLeave="Border_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource BodyTextStyle}"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HintText"
                           Style="{StaticResource SecondaryTextStyle}"
                           Visibility="Collapsed"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
