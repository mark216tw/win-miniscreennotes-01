<Window x:Class="Com.MiniScreenNotes.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/MiniScreenNotes;component/Resources/AppIcon.ico"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="ToolbarWindow_PreviewKeyDown">
    <Grid ClipToBounds="True">
        <!-- 展開狀態的完整工具面板（空白處皆可按住拖曳） -->
        <Border x:Name="ExpandedContainer"
                Margin="4"
                Padding="4"
                CornerRadius="8"
                Cursor="SizeAll"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1.5"
                MouseLeftButtonDown="ExpandedContainer_MouseLeftButtonDown"
                MouseMove="ExpandedContainer_MouseMove"
                MouseLeftButtonUp="ExpandedContainer_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ExpandedTranslateTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.32" />
            </Border.Effect>

            <DockPanel x:Name="RootDockPanel" LastChildFill="True">
                <!-- 精簡控制條（關閉、設定，依面板方向自動排布） -->
                <DockPanel x:Name="UtilityStrip" DockPanel.Dock="Right" LastChildFill="False">
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Top"
                            Padding="2"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="關閉面板"
                            AutomationProperties.Name="關閉面板"
                            Click="CloseButton_Click">
                        <Viewbox x:Name="CloseIconBox" Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon_Close}" Fill="{DynamicResource DangerBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="SettingsButton"
                            DockPanel.Dock="Top"
                            Padding="2"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="設定"
                            AutomationProperties.Name="設定"
                            Click="SettingsButton_Click">
                        <Viewbox x:Name="SettingsIconBox" Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon_Settings}" Fill="{DynamicResource TextPrimaryBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </DockPanel>

                <!-- 分隔線 -->
                <Border x:Name="FixedSeparator"
                        DockPanel.Dock="Right"
                        Background="{DynamicResource PanelBorderBrush}"
                        Margin="3,2,3,2"
                        Width="1" />

                <!-- 動態工具格線（在可用區域內置中，避免多餘空間時被擠到左上角） -->
                <Grid x:Name="ToolsGrid"
                      Margin="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 自動隱藏狀態的螢幕邊緣小手把 -->
        <Border x:Name="CollapsedHandle"
                Visibility="Collapsed"
                CornerRadius="6"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="滑鼠移入展開 mini螢幕筆記 面板"
                AutomationProperties.Name="展開面板手把"
                MouseEnter="CollapsedHandle_MouseEnter">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HandleTranslateTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border x:Name="HandleAccentBar"
                    CornerRadius="3"
                    Background="{DynamicResource HandleBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Border>

        <!-- 顏色選擇器 Popup -->
        <Popup x:Name="ColorPopup"
               StaysOpen="False"
               Placement="Bottom"
               AllowsTransparency="True"
               Closed="OptionPopup_Closed">
            <Border Margin="4"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Width="204">
                    <TextBlock Text="畫筆顏色" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />
                    <UniformGrid x:Name="ColorSwatchesGrid" Columns="5" Rows="2" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="色碼" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0" />
                        <Button Content="套用"
                                DockPanel.Dock="Right"
                                Padding="8,3"
                                Margin="6,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyHexColor_Click" />
                        <TextBox x:Name="HexColorBox"
                                 VerticalContentAlignment="Center"
                                 Padding="6,3"
                                 Text="#EF4444"
                                 KeyDown="HexColorBox_KeyDown"
                                 TextChanged="HexColorBox_TextChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 線寬選擇器 Popup -->
        <Popup x:Name="StrokePopup"
               StaysOpen="False"
               Placement="Bottom"
               AllowsTransparency="True"
               Closed="OptionPopup_Closed">
            <Border Margin="4"
                    Padding="12"
                    CornerRadius="8"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Width="220">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="線寬設定" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="StrokeWidthLabel"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Text="4 px" />
                    </DockPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <Button Content="細" Margin="0,0,4,0" Padding="4,5" Style="{StaticResource SecondaryButtonStyle}" Click="PresetStroke_Click" Tag="4" />
                        <Button Content="中" Margin="2,0,2,0" Padding="4,5" Style="{StaticResource SecondaryButtonStyle}" Click="PresetStroke_Click" Tag="6" />
                        <Button Content="粗" Margin="2,0,2,0" Padding="4,5" Style="{StaticResource SecondaryButtonStyle}" Click="PresetStroke_Click" Tag="8" />
                        <Button Content="特粗" Margin="4,0,0,0" Padding="4,5" Style="{StaticResource SecondaryButtonStyle}" Click="PresetStroke_Click" Tag="14" />
                    </UniformGrid>
                    <Slider x:Name="StrokeWidthSlider"
                            Minimum="1"
                            Maximum="30"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="StrokeWidthSlider_ValueChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
