<Window x:Class="Com.MiniScreenNotes.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:Com.MiniScreenNotes.Resources.Strings"
        Title="關於 mini螢幕筆記"
        Icon="pack://application:,,,/MiniScreenNotes;component/Resources/AppIcon.ico"
        Width="480"
        Height="640"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static strings:Strings.AppTitle}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="VersionText"
                           Margin="0,8,0,0"
                           Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Name="FileVersionText"
                           Margin="0,4,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="LicenseText"
                           Margin="0,12,0,0"
                           Style="{StaticResource BodyTextStyle}" />
                <Border Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="PrivacyText"
                               TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextStyle}" />
                </Border>

                <TextBlock Text="{x:Static strings:Strings.About_SystemInfo}"
                           Margin="0,20,0,8"
                           Style="{StaticResource SectionHeaderStyle}" />
                <Border Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_Os}"
                                   Margin="0,0,8,8"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="OsText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_Architecture}"
                                   Margin="0,0,8,8"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="ArchitectureText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_Runtime}"
                                   Margin="0,0,8,8"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="RuntimeText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_Displays}"
                                   Margin="0,0,8,8"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="DisplaysText"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_DataFolder}"
                                   Margin="0,0,8,8"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="DataFolderText"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="{x:Static strings:Strings.About_GlobalHotkey}"
                                   Margin="0,0,8,0"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="HotkeyText"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{x:Static strings:Strings.About_Shortcuts}"
                           Margin="0,20,0,8"
                           Style="{StaticResource SectionHeaderStyle}" />
                <Border Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="{x:Static strings:Strings.About_Close}"
                HorizontalAlignment="Right"
                Margin="20,0,20,20"
                MinWidth="84"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="CloseButton_Click" />
    </Grid>
</Window>
