<Window x:Class="Com.MiniScreenNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Com.MiniScreenNotes.Models"
        xmlns:strings="clr-namespace:Com.MiniScreenNotes.Resources.Strings"
        Title="mini螢幕筆記 - 設定"
        Icon="pack://application:,,,/MiniScreenNotes;component/Resources/AppIcon.ico"
        Width="720"
        Height="620"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 組態選擇列 -->
        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,12"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <DockPanel>
                <TextBlock Text="面板組態：" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox Width="200"
                          Height="28"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Margin="0,0,8,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="複製新增"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="AddProfile_Click" />
                    <Button Content="重新命名"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="RenameProfile_Click" />
                    <Button Content="刪除"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeleteProfile_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 設定分頁 -->
        <TabControl Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}">
            <!-- 分頁 1：面板與外觀 -->
            <TabItem Header="面板與外觀">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="面板尺寸與方向" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="面板大小" Style="{StaticResource BodyTextStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Width="180" Height="28"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                      SelectedValue="{Binding PanelSize}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="特小 (24px)" Tag="{x:Static models:PanelSize.ExtraSmall}" />
                                <ComboBoxItem Content="小 (30px)" Tag="{x:Static models:PanelSize.Small}" />
                                <ComboBoxItem Content="中 (38px)" Tag="{x:Static models:PanelSize.Medium}" />
                                <ComboBoxItem Content="大 (46px)" Tag="{x:Static models:PanelSize.Large}" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="面板方向" Style="{StaticResource BodyTextStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="180" Height="28"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                      SelectedValue="{Binding PanelOrientation}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="橫向（吸附上／下緣）" Tag="{x:Static models:PanelOrientation.Horizontal}" />
                                <ComboBoxItem Content="直向（吸附左／右緣）" Tag="{x:Static models:PanelOrientation.Vertical}" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="顯示模式" Style="{StaticResource BodyTextStyle}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="180" Height="28"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                      SelectedValue="{Binding DisplayMode}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="跟隨系統" Tag="{x:Static models:DisplayMode.FollowSystem}" />
                                <ComboBoxItem Content="淺色模式" Tag="{x:Static models:DisplayMode.Light}" />
                                <ComboBoxItem Content="深色模式" Tag="{x:Static models:DisplayMode.Dark}" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="主題顏色" Style="{StaticResource BodyTextStyle}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Width="180" Height="28"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                      SelectedValue="{Binding ThemeName}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="黃色護眼" Tag="{x:Static models:ThemeName.YellowEyeCare}" />
                                <ComboBoxItem Content="冰河藍" Tag="{x:Static models:ThemeName.GlacierBlue}" />
                                <ComboBoxItem Content="森林綠" Tag="{x:Static models:ThemeName.ForestGreen}" />
                                <ComboBoxItem Content="靛藍紫" Tag="{x:Static models:ThemeName.IndigoPurple}" />
                                <ComboBoxItem Content="玫瑰紅" Tag="{x:Static models:ThemeName.RoseRed}" />
                                <ComboBoxItem Content="暮光橘" Tag="{x:Static models:ThemeName.SunsetOrange}" />
                                <ComboBoxItem Content="海洋青" Tag="{x:Static models:ThemeName.OceanTeal}" />
                                <ComboBoxItem Content="櫻花粉" Tag="{x:Static models:ThemeName.SakuraPink}" />
                                <ComboBoxItem Content="摩卡棕" Tag="{x:Static models:ThemeName.MochaBrown}" />
                                <ComboBoxItem Content="石墨灰" Tag="{x:Static models:ThemeName.SlateGray}" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="每列／每行工具數量上限（超出自動折行／折列）" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="工具數量上限：" Style="{StaticResource BodyTextStyle}" Margin="0,0,8,0" />
                            <TextBox Width="64"
                                     Text="{Binding MaxItemsPerLine, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Padding="6,4" />
                        </StackPanel>

                        <TextBlock Text="邊緣吸附與自動隱藏" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="吸附到螢幕邊緣後自動隱藏為小手把"
                                  IsChecked="{Binding AutoHideWhenDocked}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="自動隱藏延遲（秒）：" Style="{StaticResource BodyTextStyle}" Margin="0,0,8,0" />
                            <Slider Width="180" Minimum="0.5" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding AutoHideDelaySeconds}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AutoHideDelaySeconds, StringFormat={}{0:0.0} 秒}"
                                       Style="{StaticResource BodyTextStyle}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 分頁 2：工具項目與排序 -->
            <TabItem Header="工具項目與排序">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Tools}"
                             SelectedItem="{Binding SelectedToolItem}"
                             Background="{DynamicResource SurfaceBackgroundBrush}"
                             BorderBrush="{DynamicResource PanelBorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Content="{Binding DisplayName}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="4,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button Content="上移" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="MoveToolUp_Click" />
                        <Button Content="下移" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,16" Click="MoveToolDown_Click" />
                        <Button Content="全部顯示" Style="{StaticResource SecondaryButtonStyle}" Click="ShowAllTools_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 分頁 3：快捷鍵、快速儲存與系統 -->
            <TabItem Header="快捷鍵與系統">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="全域喚出面板快捷鍵" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ComboBox Width="84" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding AvailableHotkeyKeys}" SelectedItem="{Binding HotkeyKeyName}" Margin="0,0,12,0" />
                            <Button Content="套用快捷鍵" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyHotkey_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding HotkeyStatusMessage}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20" />

                        <TextBlock Text="滑鼠操作" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="{x:Static strings:Strings.Settings_MiddleClickToggle}"
                                  IsChecked="{Binding MiddleClickToggleEnabled}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20" />

                        <TextBlock Text="一鍵快速儲存" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="啟用一鍵快速儲存（點擊儲存直接靜默存檔至指定資料夾，不彈出對話框）"
                                  IsChecked="{Binding QuickSaveEnabled}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="儲存資料夾：" Style="{StaticResource BodyTextStyle}" Margin="0,0,8,0" />
                            <Button Content="瀏覽..." DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BrowseQuickSaveFolder_Click" />
                            <TextBox Text="{Binding QuickSaveDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,4" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="圖片格式：" Style="{StaticResource BodyTextStyle}" Margin="0,0,8,0" />
                            <ComboBox Width="120" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectedValue="{Binding QuickSaveFormat}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="PNG（無損）" Tag="{x:Static models:ImageSaveFormat.Png}" />
                                <ComboBoxItem Content="JPEG" Tag="{x:Static models:ImageSaveFormat.Jpeg}" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="系統啟動" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="Windows 開機時自動啟動並常駐於系統匣"
                                  IsChecked="{Binding LaunchAtStartup}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按鈕 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{x:Static strings:Strings.Settings_About}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="About_Click" />
                <Button Content="完成"
                        MinWidth="90"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Close_Click" />
            </StackPanel>
            <TextBlock Text="所有變更皆會自動儲存並即時套用至工具面板。" Style="{StaticResource SecondaryTextStyle}" />
        </DockPanel>
    </Grid>
</Window>
